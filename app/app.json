{
  "expo": {
    "name": "Deadline",
    "slug": "deadline",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "scheme": "deadline",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "web": {
      "bundler": "metro",
      "name": "Deadline"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.deadline.school"
    },
    "android": {
      "package": "com.deadline.school",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7F8FA"
      }
    },
    "plugins": [
      "expo-status-bar",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "26b7f765-eefa-49f1-8a50-ea2c13d66904"
      }
    },
    "owner": "lariigewehr"
  }
}
